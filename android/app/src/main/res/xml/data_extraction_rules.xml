<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-to-device transfer rules.
  Models live in noBackupFilesDir (never copied). Settings (DataStore, holds the Hugging Face
  token) and the crash-guard prefs are excluded too. Chat history (database) may be transferred
  to a new phone; cloud backup is off entirely (allowBackup=false).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="models" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
